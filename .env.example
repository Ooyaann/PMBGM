# Salin menjadi .env.local lalu isi. Jangan commit .env.local.

# --- Supabase -------------------------------------------------------------------
# Lokal: jalankan `npm run db:status` dan salin "API URL" serta "Publishable key".
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Hanya dipakai di server (Route Handler). Jangan pernah dipakai di komponen klien.
SUPABASE_SECRET_KEY=

# Koneksi Postgres langsung untuk `npm run seed`.
# Lokal: bawaan Supabase CLI. Cloud: connection string "Session pooler" dari dashboard Supabase.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Data demo ---------------------------------------------------------------------
# Kata sandi uji untuk semua akun demo (@pantaugizi.test). Bukan kata sandi produksi.
# Jangan memakai karakter "#": dianggap awal komentar oleh pembaca berkas env.
DEMO_PASSWORD=DemoPantauGizi-2026!
# Tampilkan tombol "masuk sebagai akun demo" di halaman Masuk (untuk juri). Matikan di produksi nyata.
NEXT_PUBLIC_MODE_DEMO=true
# Opsional: waktu acuan seed (ISO 8601). Kosongkan agar memakai waktu sekarang.
SEED_ACUAN=

# --- AI (opsional, LP-11) -------------------------------------------------------------
# Kunci Gemini API dari Google AI Studio (aistudio.google.com/apikey).
# Tanpa kunci ini, klasifikasi otomatis memakai aturan kata kunci.
GEMINI_API_KEY=
# Opsional: ganti model tanpa mengubah kode. Model kecil memeriksa semua laporan,
# model utama memeriksa ulang bila model kecil gagal, kurang yakin, atau menilai darurat.
GEMINI_MODEL_KECIL=gemini-3.5-flash-lite
GEMINI_MODEL_UTAMA=gemini-3.8-flash

# --- Notifikasi email (LC-10) ---------------------------------------------------------
# Alamat situs untuk tautan di email.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Produksi: kunci Resend. Kosongkan saat pengembangan; email lokal masuk ke Mailpit Supabase
# (http://127.0.0.1:54324) atau ke MAILPIT_URL bila diisi.
RESEND_API_KEY=
EMAIL_PENGIRIM=PantauGizi <notifikasi@pantaugizi.test>
MAILPIT_URL=
