# Salin menjadi .env.local lalu isi. Jangan commit .env.local.

# --- Supabase -------------------------------------------------------------------
# Lokal: jalankan `npm run db:status` dan salin "API URL" serta "Publishable key".
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Hanya dipakai di server (Route Handler). Jangan pernah dipakai di komponen klien.
SUPABASE_SECRET_KEY=

# Koneksi Postgres langsung untuk `npm run seed`.
# Lokal: bawaan Supabase CLI. Cloud: connection string "Session pooler" dari dashboard Supabase.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Data demo ---------------------------------------------------------------------
# Kata sandi uji untuk semua akun demo (@pantaugizi.test). Bukan kata sandi produksi.
# Jangan memakai karakter "#": dianggap awal komentar oleh pembaca berkas env.
DEMO_PASSWORD=DemoPantauGizi-2026!
# Tampilkan tombol "masuk sebagai akun demo" di halaman Masuk (untuk juri). Matikan di produksi nyata.
NEXT_PUBLIC_MODE_DEMO=true
# Opsional: waktu acuan seed (ISO 8601). Kosongkan agar memakai waktu sekarang.
SEED_ACUAN=

# --- AI (opsional, LP-11) -------------------------------------------------------------
# Tanpa kunci ini, klasifikasi otomatis memakai aturan kata kunci.
ANTHROPIC_API_KEY=
